!.env.example

# Distribution / Packaging
*.tar.gz
*.zip

# Ruff / Linting cache
.ruff_cache/

# ANTLR generated (keep committed, but ignore intermediates)
*.class
*.jar

# Misc
*.log
ui/node_modules/
ui/dist/

# Schema-catalog sidecar registry (may carry connection details). The
# committed configs/catalog.example.yml is the template; the real file stays
# local. Secrets must still come from env vars, never this file.
configs/catalog.yml

# Local runtime state (corrections learning SQLite DB + WAL)
corrections.db
corrections.db-shm
corrections.db-wal
nl_corrections.db
nl_corrections.db-shm
nl_corrections.db-wal

# NL->Cypher eval harness run artifacts (WP-25.5).
# Each refresh produces tests/nl2cypher/eval/reports/<date>-<config>.{json,md}.
# The committed `baseline.json` is the gate's reference; per-run reports
# stay local (or get uploaded as CI artifacts).
tests/nl2cypher/eval/reports/
.prd-drift-queue/
.claude/
# CLAUDE.md consolidated into AGENTS.md; keep ignored in case a local Claude
# session regenerates it (AGENTS.md is the canonical, tracked agent doc).
CLAUDE.md

# Stray root npm lockfile (the real one lives in ui/package-lock.json).
/package-lock.json
